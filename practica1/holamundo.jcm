mas holamundo {

    agent alice: alice.asl {
        focus: w.c1
        roles: role1 in my_group
    }

    agent bob: sample_agent.asl {
        focus: w.c1
        roles: role2 in my_group
    }

    workspace w {
        artifact c1: example.Counter(3)
    }

    organisation o1: org.xml {
        group my_group: group1
    }

}